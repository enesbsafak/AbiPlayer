{
  "name": "abi-player",
  "version": "0.5.6-beta",
  "description": "Abi Player - beta IPTV player with Xtream Codes API + M3U support",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run prepare:binaries:win && install-electron && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false && tsc -p tsconfig.web.json --noEmit --pretty false",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsc -p e2e/tsconfig.json && electron-vite build && playwright test -c e2e/playwright.config.ts",
    "test:e2e:packaged": "node e2e/smoke/packaged-smoke.ts",
    "test:e2e:packaged-app": "playwright test -c e2e/playwright.packaged.config.ts",
    "perf:baseline": "electron-vite build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON e2e/perf/baseline.ts",
    "perf:mock": "node e2e/mock-provider/cli.ts",
    "shots": "tsc -p e2e/tsconfig.json && electron-vite build && playwright test -c e2e/playwright.shots.config.ts",
    "lint": "eslint src scripts e2e",
    "make:icons": "node scripts/make-icons.mjs",
    "notices:npm": "node scripts/generate-npm-notices.mjs",
    "lint:changed": "node scripts/lint-changed.mjs",
    "postinstall": "electron-builder install-app-deps",
    "prepare:binaries:win": "npm run prepare:mpv:win && npm run prepare:ffmpeg:win",
    "prepare:mpv:win": "node scripts/prepare-mpv-win.mjs",
    "prepare:ffmpeg:win": "node scripts/prepare-ffmpeg-win.mjs",
    "update:mpv-pin": "node scripts/update-mpv-pin.mjs",
    "update:ffmpeg-pin": "node scripts/update-ffmpeg-pin.mjs",
    "build:unpack": "npm run prepare:binaries:win && npm run build && electron-builder --dir",
    "build:win": "npm run prepare:binaries:win && npm run build && electron-builder --win",
    "release:win": "node scripts/release-win.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@playwright/test": "1.64.1",
    "@tanstack/react-virtual": "^3.11.2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.3",
    "@vitejs/plugin-react": "^5.0.0",
    "7zip-bin": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "date-fns": "^4.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.7.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "hls.js": "^1.5.17",
    "jsdom": "^29.0.2",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "zustand": "^5.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
